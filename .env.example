# URL de l'API. Docker Compose : le nom du service "api" sert de nom d'hôte.
# Hors conteneur (python -m app.agent), utiliser http://127.0.0.1:8000/metrics
METRICS_ENDPOINT=http://api:8000/metrics

# Intervalle entre deux collectes, en secondes
COLLECTION_INTERVAL=5

# Timeout HTTP en secondes
REQUEST_TIMEOUT=5

# Mot de passe admin Grafana (monitoring) : à définir dans .env, jamais versionné
GRAFANA_ADMIN_PASSWORD=changez-moi
